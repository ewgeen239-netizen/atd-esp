# ---------- server ----------
PORT=3000
# SQLite file (relative to repo root or absolute). In Docker: /data/scanner.db
DB_PATH=./data/scanner.db
# Behind Railway/Render/Nginx proxy: true (needed for correct client IP in rate limit)
TRUST_PROXY=true
# Optional HTTP Basic auth for a public URL. Leave empty to disable.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
# Requests per minute per client to /api
API_RATE_LIMIT_PER_MIN=120
# Scan history older than N days is deleted automatically (0 = keep forever)
HISTORY_RETENTION_DAYS=90
# Time zone for the "time_local" column in CSV export (browser sends its own zone)
DISPLAY_TZ=Europe/Warsaw

# ---------- lookup ----------
# The local catalog is ALWAYS checked first. Then these providers, in order:
#   autodoc  - direct, polite requests to autodoc.pl (read docs/AUTODOC.md first!)
#   scraper  - autodoc.pl pages via a scraping API (SCRAPER_* below)
#   mock     - demo data (EAN 2009999010012 ... 2009999010104), for testing the UI
# Empty value = local catalog only (safest; recommended for production).
EXTERNAL_PROVIDERS=mock

AUTODOC_BASE_URL=https://www.autodoc.pl
# Identify yourself honestly; put a real contact here if you enable "autodoc".
AUTODOC_USER_AGENT=AutodocBarcodeScanner/0.1 (warehouse EAN lookup; low volume; contact: you@example.com)
# Refuse to request paths disallowed by robots.txt. Keep true.
AUTODOC_RESPECT_ROBOTS=true

# ---------- scraping API (only if EXTERNAL_PROVIDERS contains "scraper") ----------
# scraperapi | zenrows | piloterr | custom
SCRAPER_PROVIDER=
SCRAPER_API_KEY=
# For SCRAPER_PROVIDER=custom: GET URL that returns the page HTML; {url} and {key} are substituted
SCRAPER_URL_TEMPLATE=

# ---------- politeness (shared by autodoc + scraper) ----------
# At most 1 outbound request per N ms (a lookup costs 1-2 requests)
EXTERNAL_MIN_INTERVAL_MS=3000
EXTERNAL_DAILY_LIMIT=300
EXTERNAL_MAX_QUEUE=5
EXTERNAL_TIMEOUT_MS=12000
# Pause all outbound requests for N minutes after a 403/429/captcha
EXTERNAL_COOLDOWN_MINUTES=15
# Cache: found results / "not found" results
CACHE_TTL_HOURS=168
CACHE_NEGATIVE_TTL_HOURS=24
